# 이 파일을 복사해 .env.local 로 이름을 바꾸고 값을 넣으세요.
# .env.local 은 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다.
# 키는 채팅창에 붙여 넣지 말고 이 파일에 직접 넣으세요.

# Supabase 대시보드에서 복사합니다 (프로젝트 주소와 공개 키).
# NEXT_PUBLIC_ 이 붙은 값은 브라우저에 보여도 되는 값입니다.
NEXT_PUBLIC_SUPABASE_URL=https://여기에-프로젝트-주소.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에-공개-키(anon/publishable)

# Claude Console(https://platform.claude.com)에서 발급한 API 키.
# NEXT_PUBLIC_ 이 붙지 않은 값은 서버에서만 읽혀 브라우저로 내려가지 않습니다.
ANTHROPIC_API_KEY=여기에-API-키

# (선택) 추출에 쓸 모델. 비워 두면 claude-haiku-5-5 를 씁니다.
# CLAUDE_MODEL=claude-haiku-5-5
